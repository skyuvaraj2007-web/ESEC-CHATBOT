# ============================================================
# VISIONAI BACKEND (FASTAPI) ENVIRONMENT CONFIGURATION
# ============================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini Multimodal API Key (Real VLM Reasoning)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Network & Host
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=https://your-visionai-frontend.vercel.app

# Specialized Modules (Adaptive Routing)
ENABLE_YOLO=true
YOLO_MODEL=yolov8n.pt
ENABLE_OCR=true
DEMO_OTP_MODE=true

# Realistic Neural Text-to-Speech (TTS)
# Default engine: Microsoft Azure Neural Voices via edge-tts (No API key required)
# Supported languages: English (en-IN-NeerjaNeural / en-US-AvaNeural), Tamil (ta-IN-PallaviNeural), Malayalam (ml-IN-SobhanaNeural), Hindi (hi-IN-SwaraNeural)
TTS_DEFAULT_VOICE=en-IN-NeerjaNeural
ENABLE_TTS=true
