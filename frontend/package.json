{
  "name": "visionai-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
