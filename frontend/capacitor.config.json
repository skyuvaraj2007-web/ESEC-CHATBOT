{
  "appId": "io.visionai.app",
  "appName": "VISIONAI",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "SpeechRecognition": {
      "permissions": ["microphone"]
    }
  }
}
